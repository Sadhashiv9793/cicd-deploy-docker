{
  "compilerOptions": {
    "target": "es2022",                          
    "module": "commonjs",                     // Keeps Node happy without forcing "type": "module"
    "moduleResolution": "node10",                  
    "esModuleInterop": true,                  // Crucial for importing Express smoothly
    "forceConsistentCasingInFileNames": true,  
    "strict": true,                              
    "skipLibCheck": true                         
  }
}